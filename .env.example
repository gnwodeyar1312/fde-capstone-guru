# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

# LLM Provider — OpenRouter (recommended) or Groq (fallback)
# OpenRouter: https://openrouter.ai/ — sign up and get a free API key
# Groq: https://console.groq.com/ — sign up and get a free API key
# Set ONE of these. OpenRouter is checked first.
OPENROUTER_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# Model — OpenRouter format: provider/model-name
# Groq format: model-name (e.g., llama-3.1-8b-instant)
MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# Embedding model — runs locally via sentence-transformers, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

# System parameters
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
